# =====================================================
# APP
# =====================================================
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.forceGlobalSecureRequests = false

app.namaAplikasi = 'KAPRODI - Sistem Pendukung Akreditasi'
app.namaPT = 'Universitas Teknologi Digital'
app.singkatanPT = 'UTD'

# =====================================================
# DATABASE
# =====================================================
# Di Windows GUNAKAN 127.0.0.1, bukan 'localhost'.
# 'localhost' memicu resolusi IPv6 (::1) yang sering timeout sebelum
# fallback ke IPv4, menambah ~1 detik per koneksi MySQL.
database.default.hostname = 127.0.0.1
database.default.database = kaprodi
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# =====================================================
# SESSION
# =====================================================
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = (kosongkan untuk pakai default WRITEPATH/session)

# =====================================================
# ENCRYPTION (wajib di-set di production - 32 char hex)
# =====================================================
encryption.key =

# =====================================================
# GROQ AI
# =====================================================
groq.apiKey =
groq.baseUrl = 'https://api.groq.com/openai/v1'
groq.modelLong = 'llama-3.3-70b-versatile'
groq.modelFast = 'llama-3.1-8b-instant'
groq.timeout = 60

# =====================================================
# INTEGRASI EKSTERNAL (default OFF)
# =====================================================
integrasi.pddikti.enabled = false
integrasi.pddikti.username =
integrasi.pddikti.password =
integrasi.sister.enabled = false
integrasi.sister.token =
integrasi.sinta.enabled = false

# WhatsApp Gateway Fonnte (untuk sebar kuesioner tracer study)
# Ambil token device di https://fonnte.com (menu Device).
fonnte.token =
fonnte.timeout = 30
# Placeholder pesan: {nama}, {prodi}, {link}. Kosongkan untuk pakai default.
fonnte.tracerMessage =
fonnte.kepuasanMessage =

# =====================================================
# STORAGE
# =====================================================
storage.driver = 'local'
storage.maxUploadMb = 20
storage.s3.key =
storage.s3.secret =
storage.s3.bucket =
storage.s3.region =

# =====================================================
# LOGGER
# =====================================================
logger.threshold = 4
